        "options": {
          "keepSource": "both"
        }
      },
      "id": "9cb88793-b8c7-47cb-aa54-c36c9364d85a",
      "name": "File Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per section (\"## \" heading) of each knowledge-base file. Every passage starts with\n// \"Document title > Section\", so a passage still says what it's about once it's cut out of the page.\nconst out = [];\nfor (const item of $input.all()) {\n  const text = String(item.json.text ?? '').trim();\n  if (!text) continue;\n  const source = item.binary?.data?.fileName ?? item.json.fileName ?? 'unknown.md';\n  const heading = text.match(/^#\\s+(.+)$/m);\n  const title = heading ? heading[1].trim() : source.replace(/\\.[^.]+$/, '').replace(/[-_]+/g, ' ');\n  const body = text.replace(/^#\\s+.+$/m, '').trim();\n\n  // The text before the first \"## \" is the page introduction.\n  const parts = body.split(/^(?=##\\s)/m).map((p) => p.trim()).filter(Boolean);\n  for (const part of parts) {\n    const sub = part.match(/^##\\s+(.+)$/m);\n    const section = sub ? sub[1].trim() : 'Overview';\n    const content = sub ? part.replace(/^##\\s+.+$/m, '').trim() : part;\n    out.push({ json: { source, title, section, text: title + ' > ' + section + '\\n\\n' + content } });\n  }\n}\nreturn out;\n"
      },
