{
  "id": "SbUploadDocs001",
  "name": "Knowledge base · Upload a document",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Add a document to the support knowledge base",
        "formDescription": "Markdown, text or PDF. Uploading a file with the same name replaces the old version.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Document",
              "fieldName": "document",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".md,.txt,.pdf",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Add to knowledge base",
          "path": "add-document"
        }
      },
      "id": "7c56c390-b687-495e-b4cb-84d017c4d24a",
      "name": "Upload Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "d919350e-f068-4498-8dc1-e423f9dbf2f6"
    },
    {
      "parameters": {
        "jsCode": "// The form names the file after its field; the rest of the workflow expects it in \"data\".\nconst file = Object.values($input.first().binary ?? {})[0];\nconst isPdf = file?.mimeType === 'application/pdf' || /\\.pdf$/i.test(file?.fileName ?? '');\nreturn [{ json: { source: file?.fileName ?? 'upload.md', is_pdf: isPdf }, binary: { data: file } }];\n"
      },
      "id": "58d52fc9-19f2-4966-a6c0-705722644ed5",
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "options": {},
        "method": "POST",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333') + '/collections/store-kb/points/delete?wait=true' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { must: [{ key: 'metadata.source', match: { value: $json.source } }] } }) }}"
      },
      "id": "b76a0a12-7f9f-4cd7-84cd-3cdc94a24be7",
      "name": "Remove Old Version",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $('Prepare Upload').first().json, binary: $('Prepare Upload').first().binary }];\n"
      },
      "id": "f8ce634d-9701-428d-a6cc-af5b30f046e1",
      "name": "Restore File",
      "type": "n8n-nodes-base.code",
