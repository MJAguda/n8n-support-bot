          "keepSource": "both"
        }
      },
      "id": "1403cade-c471-4e1a-aa39-de8640f3b6fa",
      "name": "PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
